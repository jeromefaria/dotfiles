# vim: filetype=neomuttrc
# OceanicNext color scheme (matching Tmux theme)
# Based on: bg=#1B2B34, fg=#D8DEE9, cyan=#6699CC, green=#99C794, yellow=#FAC863

# Basic colors
color normal      default      default         # Default text
color indicator   color234     color153        # Selected message (cyan highlight)
color status      color153     color236        # Status bar (cyan on dark grey)
color tree        color108     default         # Thread tree arrows
color error       color203     default         # Error messages (red)
color message     color153     default         # Info messages (cyan)
color tilde       color238     default         # ~ padding at end of pager
color markers     color203     color234        # + at wrapped lines
color attachment  color146     default         # Attachment indicator
color search      color0       color226        # Search highlight (black on yellow)
color bold        default      default         # Bold text
color underline   default      default         # Underlined text

# Message index colors
color index       color146     default  ~A     # All messages (light grey)
color index       color153     default  ~N     # New messages (cyan)
color index       color108     default  ~O     # Old messages (green)
color index       color203     default  ~D     # Deleted messages (red)
color index       color226     default  ~F     # Flagged messages (yellow)
color index       color238     default  ~R     # Read messages (dark grey)
color index       color111     default  ~T     # Tagged messages (blue)
color index       color196     color234 ~D     # Deleted (red on dark bg)

# Message index - specific states
color index_author  color153   default  ~N     # New message authors (cyan)
color index_author  color146   default  ~A     # All authors (light grey)
color index_subject color153   default  ~N     # New message subjects (cyan)
color index_subject color146   default  ~A     # All subjects (light grey)
color index_number  color111   default         # Message numbers (blue)
color index_date    color108   default         # Message dates (green)
color index_size    color146   default         # Message sizes (grey)
color index_flags   color226   default  ~F     # Flagged (yellow)
color index_tags    color111   default         # Tags (blue)

# Sidebar colors (matching Tmux sidebar)
# Note: some sidebar options may not be available in older neomutt versions
color sidebar_highlight   color234  color153   # Selected mailbox (dark on cyan)
color sidebar_divider     color238  default    # Divider (dark grey)
color sidebar_flagged     color226  default    # Mailbox with flagged messages (yellow)
color sidebar_new         color108  default    # Mailbox with new mail (green)
color sidebar_indicator   color234  color153   # Current mailbox indicator

# Message headers
color hdrdefault  color238  default              # Default headers (dark grey)
color header      color153  default  "^From:"    # From header (cyan)
color header      color111  default  "^To:"      # To header (blue)
color header      color111  default  "^Cc:"      # Cc header (blue)
color header      color108  default  "^Date:"    # Date header (green)
color header      color146  default  "^Subject:" # Subject header (light grey)

# Message body - quoted text (email replies)
color quoted      color108  default              # First level quote (green)
color quoted1     color153  default              # Second level (cyan)
color quoted2     color111  default              # Third level (blue)
color quoted3     color180  default              # Fourth level (yellow-orange)
color quoted4     color146  default              # Fifth level (grey)
color quoted5     color238  default              # Sixth level (dark grey)

# Message body - special content
color signature   color238  default              # Signature (dark grey)
color body        color153  default  "[\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+"  # Email addresses (cyan)
color body        color111  default  "(https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+"  # URLs (blue)

# Markdown-style formatting in emails
color body        color153  default  "^# .*"                      # H1 headings (cyan)
color body        color111  default  "^## .*"                     # H2 headings (blue)
color body        color108  default  "^### .*"                    # H3 headings (green)
color body        color226  default  "^(\t| )*[-*+] .*"           # List items (yellow)
color body        color146  default  "\\`[^\\`]+"                 # Inline code (grey)
color body        color180  default  "\\*[^*]+\\*"                # Emphasis (orange)
color body        color180  default  "_[^_]+_"                    # Emphasis (orange)
color body        color153  default  "\\*\\*[^*]+\\*\\*"          # Strong (cyan)

# PGP/GPG colors
color body        color108  default  "^gpg: Good signature .*"    # Good signature (green)
color body        color203  default  "^gpg: BAD signature .*"     # Bad signature (red)
color body        color226  default  "^gpg: WARNING: .*"          # GPG warning (yellow)
color body        color108  default  "^gpg: "                     # GPG info (green)
color body        color153  default  "^\\[-- Begin signature .*"  # Signature begin (cyan)
color body        color153  default  "^\\[-- End signature .*"    # Signature end (cyan)

# Emoticons
color body        color153  default  "[;:][-o][)/(|]"             # Emoticons (cyan)
color body        color153  default  "[;:][)(|]"                  # Emoticons (cyan)

# Progress and completion indicators
color progress    color234  color153                              # Progress bar (dark on cyan)

# Compose screen
color compose header           color146  default                  # Compose headers
color compose security_encrypt color108  default                  # Encryption indicator (green)
color compose security_sign    color108  default                  # Signature indicator (green)
color compose security_both    color108  default                  # Both (green)
color compose security_none    color238  default                  # None (dark grey)

# Prompt (for user input)
color prompt      color153  default                               # Prompt text (cyan)

# Monochrome terminal support
mono bold      bold
mono underline underline
mono indicator reverse
mono error     bold
