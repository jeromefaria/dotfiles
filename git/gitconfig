# vim: filetype=gitconfig

[user]
  name = Jerome Faria
  email = jerome.faria@gmail.com
  signingkey = ~/.ssh/id_ed25519.pub
[color]
  ui = true
[mergetool]
  keepBackup = true
[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
[push]
  default = simple
[core]
  # No excludesfile here on purpose. Setting it overrides git's own default,
  # $XDG_CONFIG_HOME/git/ignore, which in this repo is config/git/ignore — so
  # pointing it at ~/.gitignore_global meant the 31-line file was never read on
  # any machine, while the 2-line file it did point at was never linked by
  # anything: install.sh has no step for it, and the symlink on the machine
  # this was written on was made by hand. Both profiles therefore shipped with
  # no global ignore at all. Letting git find the file itself removes the
  # second copy and the step that was missing.
  pager = diff-so-fancy | less --tabs=4 -RFX
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[github]
  user = jeromefaria
[pull]
  rebase = true
[pager]
  diff = diff-so-fancy | less --tabs=4 -RFXS --pattern '^(Date|added|deleted|modified): '
[fetch]
  prune = true
[rebase]
  autostash = true
[diff]
  colorMoved = default
[commit]
  verbose = true
	gpgsign = true

# Machine-specific overrides
# Create ~/.gitconfig.local for machine-specific settings (not tracked in git)
# Example use cases:
#   - Work email: [user] email = work@company.com
#   - Different signing key: [user] signingkey = ABCD1234
#   - Custom aliases: [alias] custom = !custom-script
[include]
  path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
