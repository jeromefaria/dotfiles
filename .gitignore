# Global patterns
*.bkp
*.zip
*.log
.backup
node_modules
.DS_Store
__pycache__/

# Claude Code
.claude/

# Sensitive credentials and tokens
config/nicotine/config
config/nicotine/config.old
config/op/config
config/hub
config/AWSVPNClient/
config/gh/hosts.yml
config/beets/discogs_token.json
config/beets/secrets.yaml
config/raycast/config.json
config/jerome-tooling/config.json
config/acli/
config/rclone/rclone.conf
ssh/config.local

# Session and history files
config/**/*history*
config/**/list_history.dat
config/**/userstate.cbor

# Databases and backups
config/**/*.db
config/**/*.db-*
config/**/*.mdb
config/beets/*.backup

# Cache and state
config/**/*cache*
config/**/*.pickle
config/**/autosave
config/**/memos.json
config/**/mru
config/**/snippets-mru

# Package dependencies
config/**/node_modules/

# Application state
config/musikcube/*.txt
config/musikcube/session.json
config/musikcube/playback.json
config/musikcube/settings.json
config/musikcube/1/
config/nvim/sessions/
config/MusicBrainz/.Picard.ini.synclock
config/MusicBrainz/Picard*.ini
config/vifm/vifminfo

# mole disk-cleaner: local config/logs, not tracked
config/mole/

# 1Password: local telemetry marker, not tracked
config/1Password/

# Raycast: extension state and per-extension endpoint tokens (e.g. Aster)
config/raycast/

# mpv Last.fm scrobbler: live credentials file (see lastfm.env.template)
config/mpv/lastfm.env

# Large/build directories
config/nvim/bundle/
config/nvim/pack/nvim/start
config/nvim/plugged/
config/nvim/view/
config/raycast/extensions
config/raycast/ai/
config/iterm2/AppSupport

# Tool-generated state that was tracked by accident
# Karabiner writes these itself on every config change; they are its backups of
# karabiner.json, which IS tracked.
config/karabiner/automatic_backups/
# npm-ecosystem update-notifier/telemetry state — recreated on demand, and the
# tracked copies had gone stale (timestamps from 2018-2023, tools since dropped).
config/configstore/
# cmus library cache — a generated index of audio file paths, not configuration.
config/cmus/lib.pl
